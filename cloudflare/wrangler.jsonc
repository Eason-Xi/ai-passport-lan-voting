{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 默认使用 Cloudflare 免费提供的 *.workers.dev 地址；
  // 如需绑定自己的域名（国内网络直连更稳），可取消下方 routes 注释或复制为 wrangler.local.jsonc 使用 `npm run deploy:custom`。
  "name": "gongxuan-vote",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // "routes": [
  //   {
  //     "pattern": "vote.example.com",
  //     "custom_domain": true
  //   }
  // ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VOTING_ROOM",
        "class_name": "VotingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VotingRoom"]
    }
  ],
  "vars": {
    "ROOM_NAME": "default"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
